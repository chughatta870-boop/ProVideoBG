const { createFFmpeg, fetchFile } = FFmpeg;
const ffmpeg = createFFmpeg({ 
  log: false,
  corePath: "https://unpkg.com/@ffmpeg/core@0.12.6/dist/ffmpeg-core.js",
  progress: ({ ratio }) => {
    document.getElementById('progress').innerText = Math.round(ratio * 100) + '%';
  }
});

const video = document.getElementById('inputVideo');
const bgVideo = document.getElementById('bgVideo');
const bgImage = document.getElementById('bgImage');
const canvas = document.getElementById('outputCanvas');
const ctx = canvas.getContext('2d', { willReadFrequently: true, alpha: true });
const bgType = document.getElementById('bgType');
const loading = document.getElementById('loading');

let selfieSegmentation;
let isProcessing = false;
let bgImageLoaded = null;
let recordedChunks = [];
let mediaRecorder;
let originalAudioStream = [];

// 1. Background Type Change Logic
bgType.addEventListener('change', (e) => {
  ['bgColorGroup','bgImageGroup','bgVideoGroup'].forEach(id => 
    document.getElementById(id).style.display = 'none'
  );
  const val = e.target.value;
  if(val === 'color') document.getElementById('bgColorGroup').style.display = 'flex';
  if(val === 'image') document.getElementById('bgImageGroup').style.display = 'flex';
  if(val === 'video') document.getElementById('bgVideoGroup').style.display = 'flex';
});

// 2. Load AI Model
async function loadAI() {
  selfieSegmentation = new SelfieSegmentation({
    locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/selfie_segmentation/${file}`
  });
  selfieSegmentation.setOptions({ 
    modelSelection: 0, // mobile fast
    selfieMode: false
  });
  selfieSegmentation.onResults(onResults);
}
loadAI();

// 3. Main Video Upload
document.getElementById('videoInput').onchange = (e) => {
  const file = e.target.files[0];
  if(!file) return;
  
  if(video.src) URL.revokeObjectURL(video.src);
  video.src = URL.createObjectURL(file);
  video.muted = true; // autoplay ke liye zaroori
  
  video.onloadedmetadata = () => {
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    
    // AUDIO CAPTURE FIX: play ke baad karo warna empty aata
    video.onplay = () => {
      const stream = video.captureStream();
      originalAudioStream = stream.getAudioTracks();
      setupRecorder();
    }
    
    video.play();
    isProcessing = true;
    processVideo();
  }
}

// 4. Background Image Upload
document.getElementById('bgImageInput').onchange = (e) => {
  if(bgImage.src) URL.revokeObjectURL(bgImage.src);
  bgImage.src = URL.createObjectURL(e.target.files[0]);
  bgImage.onload = () => bgImageLoaded = bgImage;
}

// 5. Background Video Upload
document.getElementById('bgVideoInput').onchange = (e) => {
  if(bgVideo.src) URL.revokeObjectURL(bgVideo.src);
  bgVideo.src = URL.createObjectURL(e.target.files[0]);
  bgVideo.muted = true;
  bgVideo.loop = true;
  bgVideo.play();
}

// 6. Main Processing Loop
async function processVideo() {
  if(video.paused || video.ended || !isProcessing) return;
  await selfieSegmentation.send({image: video});
  requestAnimationFrame(processVideo);
}

// 7. AI Results - FIX: mask + image compositing theek kiya
function onResults(results) {
  if(!results.segmentationMask) return;
  const smoothness = document.getElementById('smoothness').value / 10;
  
  ctx.save();
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // 1. Background draw
  drawBackground(results);

  // 2. Mask bana kar person cut
  ctx.globalCompositeOperation = 'source-in';
  ctx.filter = `blur(${smoothness}px)`;
  ctx.drawImage(results.segmentationMask, 0, 0, canvas.width, canvas.height);
  ctx.filter = 'none';
  
  // 3. Person draw
  ctx.globalCompositeOperation = 'source-over';
  ctx.drawImage(results.image, 0, 0, canvas.width, canvas.height);
  ctx.restore();
}

function drawBackground(results) {
  const type = bgType.value;
  if(type === 'color'){
    ctx.fillStyle = document.getElementById('bgColor').value;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }
  if(type === 'image' && bgImageLoaded){
    ctx.drawImage(bgImageLoaded, 0, 0, canvas.width, canvas.height);
  }
  if(type === 'video' && !bgVideo.paused){
    ctx.drawImage(bgVideo, 0, 0, canvas.width, canvas.height);
  }
  if(type === 'blur'){
    ctx.filter = 'blur(20px)';
    ctx.drawImage(results.image, 0, 0, canvas.width, canvas.height);
    ctx.filter = 'none';
  }
}

// 8. Video Recorder Setup - BROWSER COMPATIBILITY FIX
function setupRecorder() {
  const videoStream = canvas.captureStream(30);
  
  const tracks = [...videoStream.getVideoTracks()];
  if(originalAudioStream.length > 0) tracks.push(...originalAudioStream);
  const combinedStream = new MediaStream(tracks);

  let mimeType = 'video/webm;codecs=vp9,opus';
  if(!MediaRecorder.isTypeSupported(mimeType)) {
    mimeType = 'video/webm;codecs=vp8,opus'; // Safari/older chrome fallback
  }

  mediaRecorder = new MediaRecorder(combinedStream, {
    mimeType: mimeType,
    videoBitsPerSecond: 5000000
  });
  
  mediaRecorder.ondataavailable = (e) => {
    if(e.data.size > 0) recordedChunks.push(e.data);
  };
  
  mediaRecorder.onstop = exportVideo;
}

// 9. Export MP4 with FFmpeg.wasm
document.getElementById('exportBtn').onclick = async () => {
  if(!video.src) return alert('Pehle video upload karo');
  
  loading.style.display = 'block';
  recordedChunks = [];
  
  video.currentTime = 0;
  video.play();
  isProcessing = true;
  processVideo();
  
  mediaRecorder.start(100);
  
  video.onended = () => {
    isProcessing = false;
    mediaRecorder.stop();
  }
}

async function exportVideo() {
  try {
    if(!ffmpeg.isLoaded()) await ffmpeg.load();
    
    const blob = new Blob(recordedChunks, { type: 'video/webm' });
    await ffmpeg.FS('writeFile', 'input.webm', await fetchFile(blob));
    
    await ffmpeg.run(
      '-i', 'input.webm', 
      '-c:v', 'libx264', 
      '-preset', 'fast',
      '-crf', '23', 
      '-c:a', 'aac', 
      '-b:a', '128k',
      '-pix_fmt', 'yuv420p', // mobile compatibility
      'output.mp4'
    );
    
    const data = ffmpeg.FS('readFile', 'output.mp4');
    const url = URL.createObjectURL(new Blob([data.buffer], { type: 'video/mp4' }));
    
    const a = document.createElement('a');
    a.href = url;
    a.download = `ProVideoBG_${Date.now()}.mp4`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    // Cleanup
    ffmpeg.FS('unlink', 'input.webm');
    ffmpeg.FS('unlink', 'output.mp4');
    
  } catch(err) {
    console.error(err);
    alert('Export me error: ' + err.message);
  } finally {
    loading.style.display = 'none';
  }
}
